source_file ::= { stmt } EOF ;

stmt ::= return_stmt
       | expr_stmt
       | var_decl
       | assign
       ;

return_stmt ::= "return" expr ";" ;
var_decl    ::= "var" ID "=" expr ";" ;
expr_stmt   ::= expr ";" ;
assign      ::= expr "=" expr ";" ;

expr ::= term ;

term    ::= factor { ("+" | "-") factor } ;
factor  ::= primary { ("*" | "/") primary } ;
primary ::= "(" expr ")"
          | INT
          | ID
          ;

ID  ::= [a-zA-Z_][a-zA-Z_0-9]+ ;
INT ::= [0-9][0-9_]+ ;
