source_file ::= { stmt } ;

stmt ::= return_stmt
       | var_decl
       | expr_stmt
       | assign
       ;

var_decl ::= "var" ID [ ":" expr ] "=" expr ";" ;

return_stmt ::= "return" expr ";" ;
expr_stmt   ::= expr ";" ;
assign      ::= primary "=" expr ";" ;

expr ::= term ;

term    ::= factor { ("+" | "-") factor } ;
factor  ::= primary { ("*" | "/") primary } ;
unary   ::= "-" unary
          | primary
          ;
primary ::= "(" expr ")"
          | INT
          | ID
          ;

ID  ::= [a-zA-Z_][a-zA-Z_0-9]+ ;
INT ::= [0-9][0-9_]+ ;
