source_file ::= return_stmt ;

return_stmt ::= "return" expr ";" ;

expr ::= term ;

term    ::= factor { ("+" | "-") factor } ;
factor  ::= primary { ("*" | "/") primary } ;
primary ::= "(" expr ")"
          | INT
          | ID
          ;

ID  ::= [a-zA-Z_][a-zA-Z_0-9]+ ;
INT ::= [0-9][0-9_]+ ;
